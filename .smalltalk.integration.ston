SmalltalkCISpec {
  #loading : [
    SCIMetacelloLoadSpec {
      #baseline : 'MooseNexus',
      #directory : 'src',
      #load : [ 'IntegrationTests' 'JavaIntegrationTests' 'TypeScriptUnitTests' 'TypeScriptIntegrationTests' ],
      #registerInIceberg : true,
      #platforms : [ #pharo ]
    }
  ],
  #testing : {
    #packages : [ 'MooseNexus-IntegrationTests' 'MooseNexus-Java-IntegrationTests' 'MooseNexus-TypeScript-Tests' 'MooseNexus-TypeScript-IntegrationTests' ]
  }
}
