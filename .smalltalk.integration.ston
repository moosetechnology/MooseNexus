SmalltalkCISpec {
  #loading : [
    SCIMetacelloLoadSpec {
      #baseline : 'MooseNexus',
      #directory : 'src',
      #load : [ 'IntegrationTests', 'JavaIntegrationTests', 'TypeScriptIntegrationTests' ],
      #registerInIceberg : true,
      #platforms : [ #pharo ]
    }
  ],
  #testing : {
    #packages : [ 'MooseNexus-IntegrationTests', 'MooseNexus-Java-IntegrationTests', 'MooseNexus-TypeScript-IntegrationTests' ]
  }
}
