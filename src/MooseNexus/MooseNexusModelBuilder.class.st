"
I am a configurable model builder.
I am used to create a Moose model for a `MooseNexusProject`.
The model is generated by a `MooseNexusModelExtractor` that knows how to parse the sources of the project.
"
Class {
	#name : 'MooseNexusModelBuilder',
	#superclass : 'Object',
	#instVars : [
		'project',
		'withDependencies',
		'extractor',
		'modelName',
		'modelComment',
		'dependencySourceSelectionPolicy',
		'dependencyResolutionResult'
	],
	#category : 'MooseNexus-ModelExtraction',
	#package : 'MooseNexus',
	#tag : 'ModelExtraction'
}

{ #category : 'instance creation' }
MooseNexusModelBuilder class >> on: aMooseNexusProject [

	^ self new project: aMooseNexusProject
]

{ #category : 'building' }
MooseNexusModelBuilder >> build [
	"Create the model and answer its recorded description."

	^ [
		  self validateExtractorRequirements.
		  self setUp.
		  self registerModel: self extractor run ] ensure: [ self cleanUp ]
]

{ #category : 'cleanup' }
MooseNexusModelBuilder >> cleanUp [
	"delete temp directories"

	(project repositoryDirectory / 'dependencies') ensureDeleteAll
]

{ #category : 'accessing' }
MooseNexusModelBuilder >> dependencyResolutionResult [

	^ dependencyResolutionResult ifNil: [ dependencyResolutionResult := MooseNexusDependencyResolutionResult forProject: project ]
]

{ #category : 'accessing' }
MooseNexusModelBuilder >> dependencyResolutionResult: aMooseNexusDependencyResolutionResult [

	dependencyResolutionResult := aMooseNexusDependencyResolutionResult
]

{ #category : 'accessing' }
MooseNexusModelBuilder >> dependencySourceSelectionPolicy [

	^ dependencySourceSelectionPolicy ifNil: [
			  dependencySourceSelectionPolicy := withDependencies
				                                     ifTrue: [ MooseNexusDependencySourceSelectionPolicy all ]
				                                     ifFalse: [ MooseNexusDependencySourceSelectionPolicy none ] ]
]

{ #category : 'accessing' }
MooseNexusModelBuilder >> dependencySourceSelectionPolicy: aMooseNexusDependencySourceSelectionPolicy [

	dependencySourceSelectionPolicy := aMooseNexusDependencySourceSelectionPolicy
]

{ #category : 'accessing' }
MooseNexusModelBuilder >> extractor [

	^ extractor ifNil: [ extractor := MooseNexusModelExtractor forLanguage: project language ]
]

{ #category : 'accessing' }
MooseNexusModelBuilder >> extractor: aMooseNexusModelExtractor [

	extractor := aMooseNexusModelExtractor
]

{ #category : 'initialization' }
MooseNexusModelBuilder >> initialize [

	withDependencies := true
]

{ #category : 'accessing' }
MooseNexusModelBuilder >> modelComment [

	^ modelComment ifNil: [ modelComment := '' ]
]

{ #category : 'accessing' }
MooseNexusModelBuilder >> modelComment: aString [

	modelComment := aString
]

{ #category : 'accessing' }
MooseNexusModelBuilder >> modelName [

	^ modelName ifNil: [ modelName := project name ]
]

{ #category : 'accessing' }
MooseNexusModelBuilder >> modelName: aString [

	modelName := aString
]

{ #category : 'accessing' }
MooseNexusModelBuilder >> project [

	^ project
]

{ #category : 'accessing' }
MooseNexusModelBuilder >> project: aMooseNexusProject [

	project := aMooseNexusProject
]

{ #category : 'building' }
MooseNexusModelBuilder >> registerModel: modelPath [
	"Name and record the model file produced by the extractor. Answer the recorded model artifact."

	| projectDirectory source target artifactPath timestamp artifactCoordinates modelArtifact manifest generatedFile |
	projectDirectory := project repositoryDirectory.
	source := projectDirectory / modelPath.
	target := (project modelArtifactsDirectory ensureCreateDirectory / self modelName , source extension) ensureDelete.
	"Copy before deleting so files produced by external tools are recreated with the image user's ownership."
	source copyTo: target.
	source ensureDelete.

	artifactPath := (target relativeTo: projectDirectory) pathString.
	timestamp := DateAndTime now asString.
	artifactCoordinates := MooseNexusModelArtifactCoordinates
		                       projectCoordinates: project coordinates
		                       name: self modelName
		                       format: source extension
		                       metamodel: 'unknown'
		                       classifier: 'main'.
	modelArtifact := MooseNexusModelArtifact
		                 artifactCoordinates: artifactCoordinates
		                 path: artifactPath
		                 comment: self modelComment
		                 timestamp: timestamp.
	generatedFile := MooseNexusModelArtifactManifest generatedFileFor: target relativeTo: projectDirectory.
	manifest := MooseNexusModelArtifactManifest
		            modelArtifact: modelArtifact
		            dependencyResolutionResult: self dependencyResolutionResult
		            generatedFiles: { generatedFile }
		            createdTimestamp: timestamp.
	project addModelManifest: manifest.
	^ modelArtifact
]

{ #category : 'building' }
MooseNexusModelBuilder >> setUp [

	| home projectDirectory dependencies selectedDependencies |
	home := FileLocator home.
	projectDirectory := project repositoryDirectory.
	selectedDependencies := project dependencies select: [ :dependency |
		                        self dependencySourceSelectionPolicy includesDependency: dependency ].

	selectedDependencies ifNotEmpty: [
			dependencies := (projectDirectory / 'dependencies') createDirectory.
			selectedDependencies do: [ :dependency |
					| artifact |
					artifact := home / dependency path.
					artifact copyTo: dependencies / artifact basename ] ].

	self extractor target: projectDirectory pathString
]

{ #category : 'validating' }
MooseNexusModelBuilder >> validateExtractorRequirements [

	(self extractor respondsTo: #validateToolRequirements) ifTrue: [ self extractor validateToolRequirements ]
]

{ #category : 'accessing' }
MooseNexusModelBuilder >> withDependencies [

	^ withDependencies
]

{ #category : 'accessing' }
MooseNexusModelBuilder >> withDependencies: aBoolean [

	withDependencies := aBoolean.
	dependencySourceSelectionPolicy := aBoolean
		                                   ifTrue: [ MooseNexusDependencySourceSelectionPolicy all ]
		                                   ifFalse: [ MooseNexusDependencySourceSelectionPolicy none ]
]
