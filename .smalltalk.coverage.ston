SmalltalkCISpec {
  #loading : [
    SCIMetacelloLoadSpec {
      #baseline : 'MooseNexus',
      #directory : 'src',
      #load : [ 'default', 'TypeScriptUnitTests' ],
      #platforms : [ #pharo ]
    }
  ],
  #testing : {
    #coverage : {
      #packages : [ 'MooseNexus', 'MooseNexus-TypeScript' ],
      #format : #lcov
    }
  }
}
